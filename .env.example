# Local AI endpoints (used by the Phase 6 adapter layer).
# Copy to .env and adjust if your Ollama / ComfyUI run on different hosts/ports.
VITE_OLLAMA_URL=http://127.0.0.1:11434
VITE_COMFYUI_URL=http://127.0.0.1:8188

# Optional cloud fallbacks (left blank by default — fully local by design).
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
